{
  "name": "dsh-archive-vault",
  "version": "0.2.3",
  "description": "dsh 插件：在设置面板中查看、恢复与永久删除归档会话",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Britneycode/dsh-archive-vault.git"
  },
  "bugs": {
    "url": "https://github.com/Britneycode/dsh-archive-vault/issues"
  },
  "homepage": "https://github.com/Britneycode/dsh-archive-vault#readme",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "archive"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "cordis": ">=4.0.0-rc <5",
    "schemastery": "^3.18.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc <2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "tsdown": "^0.22.14"
  },
  "scripts": {
    "build": "node scripts/build.mjs --all",
    "typecheck": "node scripts/build.mjs --typecheck",
    "build:client": "node scripts/build.mjs --client",
    "test": "node --test tests/archive-vault.test.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
